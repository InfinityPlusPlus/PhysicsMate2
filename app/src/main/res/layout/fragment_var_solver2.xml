<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/var_solver_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:orientation="vertical">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/linearLayout"
            style="custom_linearLayout"
            android:orientation="vertical">
        <TextView
                android:id="@+id/var_solver_text_view"
                style="@style/custom_textView"
                android:text="Please add the system of equations"
        />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="custom_linearLayout"
                android:id="@+id/var_solver_ets">
            <EditText
                    android:id="@+id/var_solver_et1"
                    style="@style/custom_edittext"
                    android:hint="3x + 2y = 10"/>


        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="custom_linearLayout"
                android:id="@+id/var_solver_MVs">

            <com.agog.mathdisplay.MTMathView
                    style="@style/custom_mathJaxView"
                    android:layout_marginTop="10dp"
                    android:id="@+id/var_solver_mv1"
            />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:id="@+id/var_solver_add_button"
                android:text="Add another row"/>

        <TextView
                style="@style/custom_textView"
                android:text="Please enter the variables present"/>

        <EditText
                style="@style/custom_edittext"
                android:id="@+id/var_solver_variables"
                android:hint="x, y"/>

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_disabled"
                android:id="@+id/var_solver_solve_button"
                android:text="Solve"/>

        <TextView
                style="@style/custom_textView"
                android:id="@+id/var_solver_solution"
                android:text="Solution:"/>

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:id="@+id/btnCopy"
                android:text="Copy to clipboard"/>
    </LinearLayout>
</ScrollView>
